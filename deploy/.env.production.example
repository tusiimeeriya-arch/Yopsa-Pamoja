# Pamoja production environment template.
#
# Copy to the server at /opt/pamoja/.env.production (mode 0600, owned by the
# deploy user) and fill every REQUIRED value there. Never commit the real file.
# The deploy user creates it; the API process never sees the owner values.
#
# Name                          Required  Example                              Secret
# ----------------------------  --------  -----------------------------------  ------
# PAMOJA_DOMAIN                 yes       pamoja-staging.duckdns.org           no
# POSTGRES_DB                   yes       pamoja                               no
# POSTGRES_USER                 yes       pamoja_owner                         no
# POSTGRES_PASSWORD             yes       <openssl rand -base64 36>            yes
# ADMIN_DATABASE_URL            yes       postgres://pamoja_owner:...@postgres:5432/pamoja  yes
# APP_DB_PASSWORD               yes       <openssl rand -base64 36>            yes
# DATABASE_URL                  yes       postgres://pamoja_app:...@postgres:5432/pamoja    yes
# AUTH_TOKEN_SECRET             yes       <openssl rand -base64 48>            yes
# PAMOJA_MASTER_KEY             yes       <openssl rand -base64 48>            yes
# PAMOJA_LOOKUP_KEY             no        <openssl rand -base64 48>            yes
# ESCALATION_JOB_SECONDS        no        3600 (minimum 60)                    no
# RANKING_JOB_SECONDS           no        86400 (minimum 60)                   no
# SMS_PROVIDER                  no        stub | http                          no
# SMS_HTTP_URL                  no        https://sms.example.net/send         no
# SMS_HTTP_TOKEN                no        <provider token>                     yes
# SMS_HTTP_FROM                 no        Pamoja                               no
# LOG_LEVEL                     no        info                                 no
# BACKUP_S3_ENDPOINT            yes       https://fra.vultrobjects.com         no
# BACKUP_S3_REGION              no        fra                                  no
# BACKUP_S3_BUCKET              yes       pamoja-backups-staging               no
# BACKUP_S3_ACCESS_KEY          yes       <Vultr Object Storage access key>    yes
# BACKUP_S3_SECRET_KEY          yes       <Vultr Object Storage secret key>    yes
# BACKUP_AGE_RECIPIENT          yes       age1... (public key, kept off-box)   no
# BACKUP_PREFIX                 no        pamoja                               no
# BACKUP_RETENTION_DAYS         no        7                                    no
# BACKUP_RETENTION_WEEKS        no        4                                    no
# BACKUP_RETENTION_MONTHS       no        6                                    no
# ALERT_WEBHOOK_URL             no        https://hooks.example.net/...        yes
# API_IMAGE / WEB_IMAGE / CADDY_IMAGE / BACKUP_IMAGE
#                               no        set by scripts/deploy.sh             no
# PAMOJA_DEMO_TOOLING           no        on (staging only); empty in production  no
#
# The API refuses to start in production when NODE_ENV is not production,
# OTP_ON_SCREEN is set, a job interval is below 60 seconds, an owner credential
# (ADMIN_DATABASE_URL, PGPASSWORD, POSTGRES_PASSWORD, ...) is in its
# environment, DATABASE_URL does not connect as pamoja_app, or a secret or the
# database password is a development default or shorter than 32 characters.

PAMOJA_DOMAIN=pamoja-staging.duckdns.org

POSTGRES_DB=pamoja
POSTGRES_USER=pamoja_owner
POSTGRES_PASSWORD=
ADMIN_DATABASE_URL=
APP_DB_PASSWORD=
DATABASE_URL=

AUTH_TOKEN_SECRET=
PAMOJA_MASTER_KEY=
PAMOJA_LOOKUP_KEY=

ESCALATION_JOB_SECONDS=3600
RANKING_JOB_SECONDS=86400
LOG_LEVEL=info

# Until an SMS/HTTP provider is configured the app starts, but actions that
# need a one-time code fail closed with a clear message.
SMS_PROVIDER=stub
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_FROM=Pamoja

BACKUP_S3_ENDPOINT=https://fra.vultrobjects.com
BACKUP_S3_REGION=fra
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_AGE_RECIPIENT=
BACKUP_PREFIX=pamoja
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=6

ALERT_WEBHOOK_URL=

# Staging only. "on" lets the edge serve the read-only admin demo guide for the
# seeded synthetic accounts; the API still requires an administrator session.
# Leave empty in production so the path answers 404 at the edge.
# The demo seed itself is a one-off command, not an environment flag; see
# docs/DEPLOYMENT.md ("Load synthetic data").
PAMOJA_DEMO_TOOLING=
