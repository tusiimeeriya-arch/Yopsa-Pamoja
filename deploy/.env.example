# Environment template.
#
# Copy to `.env` for local use and never commit the real file. In production,
# supply these through Docker/Kubernetes secrets or a secrets manager.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string used by the API and worker.
DATABASE_URL=postgres://pamoja:change_me@db:5432/pamoja?sslmode=disable

# --- Optional, with defaults ------------------------------------------------
# development | staging | production
APP_ENV=development
# Port the API listens on inside its container.
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Planned (read by later phases, not by the P0 build) --------------------
# SEED_ALLOWED=1            # P4: required, together with APP_ENV != production, to run the demo seed
# LEDGER_ADAPTER=sandbox    # P4: sandbox | alogsys
# SMS_PROVIDER=stub         # P7: stub | <provider>
# OBJECT_STORAGE_ENDPOINT=  # P1: MinIO/S3 endpoint
# OBJECT_STORAGE_BUCKET=    # P1: private evidence bucket
