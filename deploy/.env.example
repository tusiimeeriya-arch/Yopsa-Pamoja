# Environment template.
#
# Copy to `.env` for local use and never commit the real file. In production,
# supply these through Docker/Kubernetes secrets or a secrets manager.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string used by the API and worker. In production the
# role is pamoja_app: not the owner, not superuser, not BYPASSRLS.
DATABASE_URL=postgres://******@db:5432/pamoja?sslmode=disable

# Key material. Any high-entropy string works (each is stretched with SHA-256);
# generate real values with `openssl rand -base64 32`. They are never committed.
AUTH_TOKEN_SECRET=
PAMOJA_LOOKUP_KEY=
PAMOJA_MASTER_KEY=

# --- Optional, with defaults ------------------------------------------------
# development | staging | production
APP_ENV=development
# Port the API listens on inside its container.
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# Session policy (ASSUMPTIONS A-008, A-009, A-029, A-030, A-036).
# AUTH_ACCESS_TTL=15m              # never more than 15m (T-SEC-05)
# AUTH_REFRESH_TTL=336h            # 14 days
# AUTH_IDLE_STAFF=30m
# AUTH_IDLE_SHARED_PHONE=5m
# AUTH_STEP_UP_WINDOW=5m
# AUTH_LOCKOUT_FAILURES=5
# AUTH_LOCKOUT_BASE=1m
# AUTH_LOCKOUT_MAX=15m
# AUTH_MAX_DEVICES=5
# AUTH_LOGIN_PER_IP_PER_MINUTE=5
# AUTH_LOGIN_PER_ACCOUNT_PER_HOUR=10
# AUTH_ISSUER=pamoja-api
# AUTH_AUDIENCE=pamoja-client

# --- Planned (read by later phases, not by the P1 build) --------------------
# SEED_ALLOWED=1            # P4: required, together with APP_ENV != production, to run the demo seed
# LEDGER_ADAPTER=sandbox    # P4: sandbox | alogsys
# SMS_PROVIDER=stub         # P7: stub | <provider>
# OBJECT_STORAGE_ENDPOINT=  # P1: MinIO/S3 endpoint
# OBJECT_STORAGE_BUCKET=    # P1: private evidence bucket
